# /opt/wekan/wekan.env as deployed on the TrueOG server, with secrets replaced by <placeholders>.
# Generated from the live file; never commit the real one (it is mode 600, owner system).
export MONGO_URL='mongodb://<user>:<password>@127.0.0.1:27017/wekan?authSource=<db>'
export ROOT_URL='https://todo.true-og.net'
# Listen on loopback only: nginx proxies to 127.0.0.1:3001 (todo.true-og.net).
# Meteor's webapp uses process.env.BIND_IP || '0.0.0.0'.
export BIND_IP=127.0.0.1
export PORT=3001
export MAIL_URL='smtps://<user>:<password>@<mail host>:465/'
export MAIL_FROM='Wekan Automated Message <admin@true-og.net>'
export WRITABLE_PATH='/opt/wekan/data'
export METEOR_REACTIVITY_ORDER='polling'
# Added for WeKan 10.99 (2026-09-19):
# Exports (PDF/Excel/JSON/CSV) are served from /api/... and refused unless WITH_API=true.
export WITH_API=true
# FerretDB has no oplog/change streams, so Meteor polls; calmer re-poll cadence (WeKan launcher defaults).
export METEOR_POLLING_THROTTLE_MS=2000
export METEOR_POLLING_INTERVAL_MS=30000

# Staff-Auth sign-in (2026-11-11): Hydra client "TrueOG WeKan" (/root/hydra-client-wekan.json), client_secret_post.
# Any active Staff-Auth account may sign in; existing accounts are linked by services.oidc.id = Staff-Auth uuid.
# Staff-Auth is the only sign-in (password login removed 2026-11-11). Deactivation/deletion locks via trueog-wekan-authwatch.
export OAUTH2_ENABLED='true'
export OAUTH2_LOGIN_STYLE='redirect'
export OAUTH2_CLIENT_ID='<client id from /root/hydra-client-wekan.json>'
export OAUTH2_SECRET='<client secret from /root/hydra-client-wekan.json>'
export OAUTH2_SERVER_URL='https://staff-auth.true-og.net'
export OAUTH2_AUTH_ENDPOINT='/oauth2/auth'
export OAUTH2_TOKEN_ENDPOINT='/oauth2/token'
export OAUTH2_USERINFO_ENDPOINT='/userinfo'
export OAUTH2_REQUEST_PERMISSIONS='openid profile email'
export OAUTH2_ID_MAP='sub'
export OAUTH2_USERNAME_MAP='preferred_username'
export OAUTH2_FULLNAME_MAP='name'
export OAUTH2_EMAIL_MAP='email'

# Real client address (2026-11-11). nginx (conf.d/cloudflare-realip.conf: real_ip_header CF-Connecting-IP from
# Cloudflare's ranges only) appends the visitor's address as the LAST X-Forwarded-For entry, so trust exactly one
# hop. Without this every request looked like 127.0.0.1: one shared REST-login throttle key for the whole internet.
# WeKan listens on 127.0.0.1 only (BIND_IP), so nobody can reach it without nginx writing that entry.
export HTTP_FORWARDED_COUNT=1

# Operator 2026-11-11: WeKan behaves like Gitea: a signed-out visit goes straight to Staff-Auth sign-in (one
# automatic attempt per browser tab; if it fails, the same tab shows the sign-in page with the password fallback).
export OIDC_REDIRECTION_ENABLED=true

# Operator 2026-11-11: "I dont want wekan's sign in page at all, except a link to sign in with staff-auth like
# gitea has". The password form is hidden; linked accounts have no stored password (removed, backup
# /opt/wekan/backups/pre-nopassword-*), so the server refuses password logins as well. No fallback: if
# Staff-Auth/Hydra is down, WeKan sign-in waits for it.
export PASSWORD_LOGIN_ENABLED=false
